{
  "name": "@sandsoftwaresolutions/rate-limit",
  "version": "0.1.1",
  "description": "Rate limiting in memory: sliding window, memory cap, honest Retry-After, middleware for node:http and Express.",
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test && node scripts/build-cjs.mjs --check",
    "pack:check": "npm pack --dry-run",
    "build": "node scripts/build-cjs.mjs",
    "prepack": "node scripts/build-cjs.mjs"
  },
  "keywords": [
    "rate-limit",
    "throttle",
    "express",
    "middleware"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SandSoftwareSolutions/ss-rate-limit.git"
  },
  "bugs": {
    "url": "https://github.com/SandSoftwareSolutions/ss-rate-limit/issues"
  },
  "homepage": "https://github.com/SandSoftwareSolutions/ss-rate-limit#readme",
  "publishConfig": {
    "access": "public"
  }
}
